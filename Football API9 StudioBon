# ba_meta require api 9

from __future__ import annotations

from typing import override

import bascenev1 as bs


# ============================================================
# SOCCER PLAYER
# ============================================================

class SoccerPlayer(bs.Player['SoccerTeam']):
    pass


# ============================================================
# SOCCER TEAM
# ============================================================

class SoccerTeam(bs.Team[SoccerPlayer]):

    def __init__(self) -> None:
        super().__init__()
        self.score = 0


# ============================================================
# SOCCER BALL
# ============================================================

class SoccerBall(bs.Actor):

    def __init__(
        self,
        position: tuple[float, float, float],
    ) -> None:

        super().__init__()

        shared = bs.SharedObjects.get()

        material = bs.Material()

        material.add_actions(
            actions=(
                (
                    'modify_part_collision',
                    'friction',
                    0.15,
                ),
                (
                    'modify_part_collision',
                    'stiffness',
                    0.15,
                ),
            )
        )

        self.node = bs.newnode(
            'prop',
            delegate=self,
            attrs={
                'position': position,
                'body': 'sphere',
                'body_scale': 0.8,
                'mesh': bs.getmesh('impactBomb'),
                'color_texture': bs.gettexture(
                    'impactBombColor'
                ),
                'reflection': 'soft',
                'reflection_scale': [0.2],
                'shadow_size': 0.5,
                'materials': (
                    shared.object_material,
                    material,
                ),
            },
        )

    def reset(
        self,
        position: tuple[float, float, float],
    ) -> None:

        if not self.node.exists():
            return

        self.node.position = position

        self.node.velocity = (
            0.0,
            0.0,
            0.0,
        )


# ============================================================
# GOAL MESSAGE
# ============================================================

class GoalMessage:

    def __init__(
        self,
        team: SoccerTeam,
    ) -> None:

        self.team = team


# ============================================================
# SOCCER GAME
# ============================================================

# ba_meta export bascenev1.GameActivity
class SoccerGame(
    bs.TeamGameActivity[
        SoccerPlayer,
        SoccerTeam,
    ]
):

    name = 'Soccer'

    description = (
        'Score goals with the soccer ball.'
    )

    scoreconfig = bs.ScoreConfig(
        label='Goals',
        scoretype=bs.ScoreType.POINTS,
        lower_is_better=False,
        none_is_best=False,
    )

    default_music = bs.MusicType.FOOTBALL

    available_settings = [

        bs.IntSetting(
            'Score to Win',
            default=5,
            min_value=1,
            max_value=99,
            increment=1,
        ),

        bs.IntChoiceSetting(
            'Time Limit',
            default=0,

            choices=[
                ('None', 0),
                ('1 Minute', 60),
                ('2 Minutes', 120),
                ('5 Minutes', 300),
                ('10 Minutes', 600),
            ],
        ),
    ]

    # ========================================================
    # SESSION
    # ========================================================

    @classmethod
    def supports_session_type(
        cls,
        sessiontype: type[bs.Session],
    ) -> bool:

        return issubclass(
            sessiontype,
            bs.DualTeamSession,
        )

    # ========================================================
    # MAP
    # ========================================================

    @classmethod
    def get_supported_maps(
        cls,
        sessiontype: type[bs.Session],
    ) -> list[str]:

        return ['Hockey']

    # ========================================================
    # INIT
    # ========================================================

    def __init__(
        self,
        settings: dict,
    ) -> None:

        super().__init__(settings)

        self._ball: SoccerBall | None = None

        self._score_to_win = int(
            settings.get(
                'Score to Win',
                5,
            )
        )

        self._time_limit = int(
            settings.get(
                'Time Limit',
                0,
            )
        )

        self._goal_locked = False

    # ========================================================
    # TRANSITION
    # ========================================================

    @override
    def on_transition_in(self) -> None:

        super().on_transition_in()

        self.globalsnode.tint = (
            0.8,
            1.0,
            0.8,
        )

    # ========================================================
    # BEGIN
    # ========================================================

    @override
    def on_begin(self) -> None:

        super().on_begin()

        self._ball = SoccerBall(
            position=(
                0.0,
                1.2,
                0.0,
            )
        )

        if self._time_limit > 0:

            self.setup_standard_time_limit(
                self._time_limit
            )

        for player in self.players:

            self.spawn_player(player)

        bs.timer(
            0.05,
            bs.WeakCall(
                self._check_ball
            ),
            repeat=True,
        )

    # ========================================================
    # SPAWN PLAYER
    # ========================================================

    @override
    def spawn_player(
        self,
        player: SoccerPlayer,
    ) -> bs.PlayerSpaz:

        if player.team.id == 0:

            position = (
                -3.5,
                1.0,
                0.0,
            )

            angle = 0.0

        else:

            position = (
                3.5,
                1.0,
                0.0,
            )

            angle = 180.0

        spaz = self.spawn_player_spaz(
            player,
            position=position,
            angle=angle,
        )

        player.actor = spaz

        return spaz

    # ========================================================
    # CHECK BALL
    # ========================================================

    def _check_ball(self) -> None:

        if self._ball is None:
            return

        if not self._ball.node.exists():
            return

        if self._goal_locked:
            return

        x, y, z = (
            self._ball.node.position
        )

        # LEFT GOAL
        if (
            x <= -5.2
            and
            0.25 <= y <= 2.8
            and
            abs(z) <= 1.8
        ):

            self.handlemessage(
                GoalMessage(
                    self.teams[1]
                )
            )

        # RIGHT GOAL
        elif (
            x >= 5.2
            and
            0.25 <= y <= 2.8
            and
            abs(z) <= 1.8
        ):

            self.handlemessage(
                GoalMessage(
                    self.teams[0]
                )
            )

    # ========================================================
    # HANDLE MESSAGE
    # ========================================================

    @override
    def handlemessage(
        self,
        msg: object,
    ) -> object:

        if isinstance(
            msg,
            GoalMessage,
        ):

            self._goal(
                msg.team
            )

            return None

        return super().handlemessage(
            msg
        )

    # ========================================================
    # GOAL
    # ========================================================

    def _goal(
        self,
        team: SoccerTeam,
    ) -> None:

        if self._goal_locked:
            return

        self._goal_locked = True

        team.score += 1

        bs.screenmessage(
            f'GOAL!  {team.score}',
            color=(
                1.0,
                1.0,
                0.0,
            ),
            scale=2.0,
        )

        try:

            bs.getsound(
                'score'
            ).play()

        except Exception:
            pass

        bs.timer(
            1.0,
            bs.WeakCall(
                self._reset_after_goal
            ),
        )

    # ========================================================
    # RESET
    # ========================================================

    def _reset_after_goal(
        self,
    ) -> None:

        if (
            self.teams[0].score
            >= self._score_to_win
            or
            self.teams[1].score
            >= self._score_to_win
        ):

            self._end_game()

            return

        if self._ball is not None:

            self._ball.reset(
                (
                    0.0,
                    1.2,
                    0.0,
                )
            )

        for player in self.players:

            if player.actor is None:
                continue

            if not player.actor.node.exists():
                continue

            if player.team.id == 0:

                player.actor.node.position = (
                    -3.5,
                    1.0,
                    0.0,
                )

            else:

                player.actor.node.position = (
                    3.5,
                    1.0,
                    0.0,
                )

            player.actor.node.velocity = (
                0.0,
                0.0,
                0.0,
            )

        bs.timer(
            1.0,
            bs.WeakCall(
                self._unlock_goal
            ),
        )

    # ========================================================
    # UNLOCK GOAL
    # ========================================================

    def _unlock_goal(self) -> None:

        self._goal_locked = False

    # ========================================================
    # END GAME
    # ========================================================

    def _end_game(self) -> None:

        results = bs.GameResults()

        results.set_team_score(
            self.teams[0],
            self.teams[0].score,
        )

        results.set_team_score(
            self.teams[1],
            self.teams[1].score,
        )

        self.end(
            results=results
        )
