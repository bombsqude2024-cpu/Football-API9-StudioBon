# ba_meta export bascenev1.GameActivity
class SoccerGame(
    bs.TeamGameActivity[SoccerPlayer, SoccerTeam]
):
    """Two-team soccer game."""

    name = 'Soccer'
    description = 'Score goals with the soccer ball.'

    scoreconfig = bs.ScoreConfig(
        label='Goals',
        scoretype=bs.ScoreType.POINTS,
        lower_is_better=False,
        none_is_best=False,
    )

    default_music = bs.MusicType.FOOTBALL

    available_settings = [
        bs.IntSetting(
            'Score to Win',
            default=5,
            min_value=1,
            max_value=99,
            increment=1,
        ),
        bs.IntChoiceSetting(
            'Time Limit',
            default=0,
            choices=[
                ('None', 0),
                ('1 Minute', 60),
                ('2 Minutes', 120),
                ('5 Minutes', 300),
                ('10 Minutes', 600),
            ],
        ),
    ]

    @classmethod
    def supports_session_type(
        cls,
        sessiontype: type[bs.Session],
    ) -> bool:
        return issubclass(
            sessiontype,
            bs.DualTeamSession,
        )

    @classmethod
    def get_supported_maps(
        cls,
        sessiontype: type[bs.Session],
    ) -> list[str]:
        return ['Hockey']

    def __init__(
        self,
        settings: dict,
    ) -> None:
        super().__init__(settings)

        self._ball: SoccerBall | None = None
        self._goal_locked = False

        self._score_to_win = int(
            settings.get('Score to Win', 5)
        )

        self._time_limit = int(
            settings.get('Time Limit', 0)
        )

        self._score_sound = bs.getsound('score')

    # ========================================================
    # TRANSITION
    # ========================================================

    @override
    def on_transition_in(self) -> None:
        super().on_transition_in()

        self.globalsnode.tint = (
            0.75,
            1.0,
            0.75,
        )

    # ========================================================
    # BEGIN
    # ========================================================

    @override
    def on_begin(self) -> None:
        super().on_begin()

        self._ball = SoccerBall()

        if self._time_limit > 0:
            self.setup_standard_time_limit(
                self._time_limit
            )

        for player in self.players:
            self.spawn_player(player)

        bs.timer(
            0.05,
            bs.WeakCall(self._check_ball),
            repeat=True,
        )

    # ========================================================
    # SPAWN PLAYER
    # ========================================================

    @override
    def spawn_player(
        self,
        player: SoccerPlayer,
    ) -> PlayerSpaz:

        if player.team.id == 0:
            position = LEFT_PLAYER_POSITION
            angle = 0.0
        else:
            position = RIGHT_PLAYER_POSITION
            angle = 180.0

        spaz = self.spawn_player_spaz(
            player,
            position=position,
            angle=angle,
        )

        player.actor = spaz

        return spaz

    # ========================================================
    # RESET PLAYERS
    # ========================================================

    def _reset_players(self) -> None:

        for player in self.players:

            spaz = player.actor

            if spaz is None:
                continue

            if not spaz.node.exists():
                continue

            if player.team.id == 0:
                position = LEFT_PLAYER_POSITION
                angle = 0.0
            else:
                position = RIGHT_PLAYER_POSITION
                angle = 180.0

            spaz.node.position = position

            spaz.node.velocity = (
                0.0,
                0.0,
                0.0,
            )

            spaz.node.angle = angle

    # ========================================================
    # CHECK BALL
    # ========================================================

    def _check_ball(self) -> None:

        if self._ball is None:
            return

        if not self._ball.node.exists():
            return

        if self._goal_locked:
            return

        position = self._ball.node.position

        x = position[0]
        y = position[1]
        z = position[2]

        if y < GOAL_Y_MIN or y > GOAL_Y_MAX:
            return

        if abs(z) > GOAL_Z_MAX:
            return

        # LEFT GOAL
        if x <= LEFT_GOAL_X:

            self.handlemessage(
                GoalMessage(1)
            )

            return

        # RIGHT GOAL
        if x >= RIGHT_GOAL_X:

            self.handlemessage(
                GoalMessage(0)
            )

    # ========================================================
    # MESSAGE
    # ========================================================

    @override
    def handlemessage(
        self,
        msg: Any,
    ) -> Any:

        if isinstance(msg, GoalMessage):

            if self._goal_locked:
                return None

            self._score_goal(
                self.teams[msg.team_id]
            )

            return None

        return super().handlemessage(msg)

    # ========================================================
    # SCORE GOAL
    # ========================================================

    def _score_goal(
        self,
        team: SoccerTeam,
    ) -> None:

        if self._goal_locked:
            return

        self._goal_locked = True

        team.score += 1

        try:
            self.stats.player_scored(
                None,
                team=team,
                score=1,
            )
        except Exception:
            pass

        try:
            self._score_sound.play(
                volume=1.0
            )
        except Exception:
            pass

        try:
            self.celebrate()
        except Exception:
            pass

        bs.timer(
            RESET_DELAY,
            bs.WeakCall(
                self._reset_after_goal
            ),
        )

    # ========================================================
    # RESET AFTER GOAL
    # ========================================================

    def _reset_after_goal(self) -> None:

        for team in self.teams:
            if team.score >= self._score_to_win:
                self._finish_game()
                return

        if self._ball is not None:
            self._ball.reset()

        self._reset_players()

        bs.timer(
            GOAL_COOLDOWN,
            bs.WeakCall(
                self._unlock_goal
