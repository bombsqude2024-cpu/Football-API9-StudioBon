import bauiv1 as bui


class SoccerGamePlugin(bs.Plugin):
    """Loads the Soccer custom game in API 9."""

    @override
    def on_app_running(self) -> None:
        bui.app.meta.load_exported_classes(
            bs.GameActivity,
            self._game_loaded,
            completion_cb_in_bg_thread=True,
        )

    @staticmethod
    def _game_loaded(
        gametypes: list[type[bs.GameActivity]],
    ) -> None:
        pass            ),
        )

    # ========================================================
    # UNLOCK
    # ========================================================

    def _unlock_goal(self) -> None:
        self._goal_locked = False

    # ========================================================
    # END GAME
    # ========================================================

    @override
    def _finish_game(self) -> None:

        results = bs.GameResults()

        results.set_game(self)

        for team in self.teams:
            results.set_team_score(
                team,
                team.score,
            )

        self.end(
            results=results
        )
